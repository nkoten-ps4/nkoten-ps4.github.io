<html manifest="cache.appcache">
  <head>
    <title>PS4 JB: 13.02 - 13.52</title>
    <style>
      :root {
        --bg: #05060a;
        --bg2: #0a0f1a;
        --fg: #c8ffe0;
        --fg-dim: #6b8f7d;
        --accent: #00ff9c;
        --accent2: #ff00d4;
        --warn: #ffd400;
        --bad: #ff3355;
        --line: #0f2b22;
        --glow: 0 0 6px rgba(0, 255, 156, 0.65);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font:
          14px/1.5 'Consolas',
          'Menlo',
          'Courier New',
          monospace;
        text-align: center;
        overflow: hidden;
        min-height: 100vh;
      }

      /* scanlines + grid overlay */
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1000;
        background: repeating-linear-gradient(
          to bottom,
          rgba(0, 255, 156, 0.03) 0px,
          rgba(0, 255, 156, 0.03) 1px,
          transparent 1px,
          transparent 3px
        );
        mix-blend-mode: screen;
      }

      body::after {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 999;
        background: radial-gradient(
          ellipse at 50% 40%,
          transparent 40%,
          rgba(0, 0, 0, 0.55) 100%
        );
      }

      .info {
        position: absolute;
        top: 50%;
        left: 50%;
        font-family: 'Consolas', 'Menlo', 'Courier New', monospace;
        font-size: 16px;
        color: var(--fg);
        transform: translate(-50%, -50%);
        letter-spacing: 0.12em;
        white-space: nowrap;
        text-transform: uppercase;
        padding: 18px 26px;
        border: 1px solid var(--line);
        background: linear-gradient(
          180deg,
          rgba(0, 255, 156, 0.03) 0%,
          rgba(0, 0, 0, 0) 100%
        );
        box-shadow:
          0 0 20px rgba(0, 255, 156, 0.08),
          inset 0 0 30px rgba(0, 255, 156, 0.03);
        z-index: 10;
      }

      .info::before {
        content: '>_ ';
        color: var(--accent2);
        opacity: 0.7;
      }

      .info::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          var(--accent),
          transparent
        );
        animation: scan 3s linear infinite;
      }

      @keyframes scan {
        0%,
        100% {
          opacity: 0.3;
        }
        50% {
          opacity: 1;
        }
      }

      .info b {
        color: var(--accent);
        font-weight: 700;
        text-shadow: var(--glow);
      }

      /* terminal cursor blink appended at end */
      .info .cursor::after {
        content: '▌';
        color: var(--accent);
        margin-left: 4px;
        animation: blink 1s steps(2) infinite;
        text-shadow: var(--glow);
      }

      @keyframes blink {
        50% {
          opacity: 0;
        }
      }
    </style>
    <script>
      /*
       * Cache primer.
       *
       * Every asset the exploit chain needs (jb.js, core.js, mem.js, int64.js,
       * ps4_offsets.js, rpc_worker.js, hen.bin, goldhen.bin, ps4debug.bin,
       * patches/*.bin) is listed in cache.appcache. If a user lands on
       * index.html directly, the exploit starts BEFORE those downloads finish
       * and any fetch(PAYLOAD_FILE) during the run is a live network fetch --
       * an extra chance for a mid-exploit stall on a flaky Wi-Fi.
       *
       * cache.html sits in front of that: it does nothing but download the
       * manifest with visible progress, then reload the tab. The reload
       * re-triggers AppCache, but this time every entry is already in the
       * on-console cache -- index.html loads instant, jb.js does the same,
       * and every fetch inside the exploit becomes a local read.
       *
       * The history-stack collapse below is copied from the mansoor0x/polpNO
       * variant of this pattern: WebKit's back-forward cache can hold onto
       * a stale-primed exploit state from a previous run, and wiping the
       * history entries before the reload makes the second load look like a
       * fresh navigation.
       */

      // Swap the visible URL to index.html without navigating -- so when the
      // AppCache-completion handler below calls location.reload(), the reload
      // actually hits index.html (the exploit page), not this page.
      history.replaceState(null, null, 'index.html');

      // Collapse the tab history so back-button behaviour is clean and WebKit
      // isn't holding references to an earlier navigation state.
      var histlength = history.length;
      try {
        history.go(-histlength);
      } catch (e) {}

      function DLProgress(e) {
        var msgs = document.getElementById('msgs');
        if (!msgs) return;
        var pct = e.total ? Math.round((e.loaded / e.total) * 100) : 0;
        msgs.innerHTML =
          'PS4 do Papito &middot; Instalando ... <b>' + pct + '%</b>';
      }

      function DisplayCacheProgress() {
        var msgs = document.getElementById('msgs');
        setTimeout(function () {
          if (msgs) msgs.innerHTML = 'PS4 do Papito &middot; <b>Cache OK</b>';
        }, 1500);
        setTimeout(function () {
          location.reload();
        }, 2500);
      }

      if (window.applicationCache) {
        window.applicationCache.addEventListener('progress', DLProgress, false);
        window.applicationCache.oncached = function () {
          DisplayCacheProgress();
        };
        window.applicationCache.onupdateready = function () {
          DisplayCacheProgress();
        };
        // If the cache is already there (repeat visit) neither event fires -- just
        // hand off to the exploit page.
        window.applicationCache.addEventListener(
          'noupdate',
          function () {
            setTimeout(function () {
              location.reload();
            }, 200);
          },
          false,
        );
      }
    </script>
  </head>
  <body>
    <div id="msgs" class="info">PS4 do Papito &middot; Priming cache ...</div>
  </body>
</html>
